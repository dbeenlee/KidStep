# ==================== 数据库（Supabase） ====================
DATABASE_URL="postgresql://user:password@host:5432/kidstep?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/kidstep?schema=public"

# ==================== NextAuth ====================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-secret-at-least-32-chars"

# ==================== 站点配置 ====================
# 用于 SEO（sitemap、robots、canonical URL 等）
NEXT_PUBLIC_BASE_URL="https://kidstep.app"

# ==================== 短信服务（阿里云） ====================
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME="童行"
ALIYUN_SMS_TEMPLATE_CODE=""

# ==================== 微信登录（开放平台网站应用） ====================
# 需要在 https://open.weixin.qq.com 注册网站应用并审核通过
# 回调域名需与 NEXTAUTH_URL 一致
WECHAT_OPEN_APPID=""
WECHAT_OPEN_APPSECRET=""

# ==================== 邮件服务（SMTP） ====================
# 用于发送注册验证码和密码重置验证码
# 开发模式下不配置也可以工作（验证码通过 console.log 输出）
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="童行 <noreply@kidstep.app>"

# ==================== Vercel Analytics ====================
# 部署到 Vercel 后自动启用，无需手动配置

# ==================== AI 服务 ====================
# 支持 OpenAI 兼容接口 + 阿里云 / 腾讯云 / 百度云专用接口
# 系统会根据 AI_BASE_URL 自动识别提供商
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# 百度云需要额外配置 AI_API_SECRET（用于获取 access_token）
AI_API_SECRET=""

# --- OpenAI 兼容接口 ---
# DeepSeek:  AI_BASE_URL="https://api.deepseek.com/v1"       AI_MODEL="deepseek-chat"
# MiMo:     AI_BASE_URL="https://api.mimo.com/v1"            AI_MODEL="mimo-v2"
# MiniMax:  AI_BASE_URL="https://api.minimax.chat/v1"        AI_MODEL="abab6.5-chat"
# Kimi:     AI_BASE_URL="https://api.moonshot.cn/v1"         AI_MODEL="moonshot-v1-8k-vision"
# OpenAI:   AI_BASE_URL="https://api.openai.com/v1"          AI_MODEL="gpt-4o-mini"

# --- 阿里云（通义千问） ---
# 图像识别: AI_MODEL="qwen-vl-plus"
# 语音转写: 使用 Paraformer（自动选择）
# AI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# --- 腾讯云（混元） ---
# 图像识别: AI_MODEL="hunyuan-vision"
# 语音转写: 使用 whisper-large-v3（自动选择）
# AI_BASE_URL="https://api.hunyuan.cloud.tencent.com/v1"

# --- 百度云（ERNIE） ---
# 图像识别: AI_MODEL="ernie-4.0"
# 语音转写: 使用百度语音识别（自动选择）
# AI_BASE_URL="https://aip.baidubce.com/rpc/2.0/ai_custom/v1"
# 需要配置 AI_API_KEY（client_id）和 AI_API_SECRET（client_secret）
